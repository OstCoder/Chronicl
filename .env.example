# Chronicl / civictrace environment template.
# Copy to .env.local and fill in ONLY the real values (never commit them).
#
# GNews backend (vite.config.ts dev middleware AND the api/gnews.ts
# Vercel function; free tier key):
GNEWS_API_KEY=
# Groq AI story grouping (vite.config.ts dev middleware AND the api/groq.ts
# Vercel function):
GROQ_API_KEY=
# PRODUCTION NOTE: the api/*.ts serverless functions read these two keys
# from VERCEL — set GNEWS_API_KEY and GROQ_API_KEY in the Vercel project's
# Environment Variables (Production), then redeploy. Without them the live
# site shows the front end but storylines never group (HTTP 500 from the
# backend).
# Supabase daily-snapshot storage (browser reads with the anon key under
# RLS; the ingest Edge Function reads SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY — those two are set as Supabase SECRETS via
# `supabase secrets set`, NOT in this file).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed when DEPLOYING the ingest Edge Function yourself (never here):
#   SUPABASE_ACCESS_TOKEN / project ref via `npx supabase link --project-ref <ref>`
